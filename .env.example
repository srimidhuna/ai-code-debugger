OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-coder-32b-instruct
OPENROUTER_TIMEOUT=60
MAX_SOURCE_BYTES=102400
MAX_SOURCE_LINES=3000
DATABASE_URL=sqlite:///./debugger.db
FRONTEND_ORIGIN=http://localhost:5173
# Provider routing order for OpenRouter (e.g. Cloudflare). Leave empty to use OpenRouter default.
OPENROUTER_PROVIDER_ORDER=Cloudflare
# Set to true to log raw AI responses to console for debugging (never logs API keys)
DEBUG_AI_RESPONSES=false

