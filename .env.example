OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-coder-32b-instruct
OPENROUTER_TIMEOUT=60
MAX_SOURCE_BYTES=102400
MAX_SOURCE_LINES=3000
DATABASE_URL=sqlite:///./debugger.db
FRONTEND_ORIGIN=http://localhost:5173
# Comma-separated OpenRouter provider routing list (e.g. Cloudflare).
# When set, OpenRouter routes completions only to the specified providers with fallbacks disabled,
# ensuring predictable behaviour and format consistency. Leave blank for default routing.
OPENROUTER_PROVIDER_ORDER=Cloudflare
# Set to true to log raw AI responses to console for debugging (never logs API keys)
DEBUG_AI_RESPONSES=false
